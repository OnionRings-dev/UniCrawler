GROQ_API_KEY=
OPENAI_API_KEY=

# When running this CLI on the host, use localhost even if the compose services use http://qdrant:6333.
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=

RAG_COLLECTION_PREFIX=unicrawler
# Optional comma-separated allow-list. Leave empty to search every collection with RAG_COLLECTION_PREFIX.
RAG_COLLECTIONS=

# Keep these aligned with the vectorizer settings used to create the Qdrant vectors.
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

RAG_CHAT_PROVIDER=groq
RAG_CHAT_MODEL=llama-3.3-70b-versatile
RAG_CANDIDATE_LIMIT=30
RAG_CONTEXT_LIMIT=5
RAG_SOURCE_LIMIT=3
RAG_RERANKER_PROVIDER=local
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_KEYWORD_BOOST=true
RAG_MAX_TOOL_RESULTS=12
