# Infrastructure
POSTGRES_DB=unicrawler
POSTGRES_USER=unicrawler
POSTGRES_PASSWORD=unicrawler
POSTGRES_PORT=5432

REDIS_ADDR=redis:6379
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

QDRANT_URL=http://qdrant:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Mapper
MAPPER_INPUT_QUEUE=mapper:in
MAPPER_OUTPUT_QUEUE=mapper:out
MAPPER_VISITED_PREFIX=mapper:visited
MAPPER_WORKERS=128
MAPPER_REDIS_POOL_SIZE=256
MAPPER_REDIS_BATCH_SIZE=1000
MAPPER_SAME_DOMAIN_MODE=registrable
MAPPER_MAX_PAGES_PER_SEED=0
MAPPER_REQUEST_TIMEOUT=15s
MAPPER_IDLE_CONN_TIMEOUT=90s
MAPPER_QUEUE_BLOCK_TIME=5s
MAPPER_USER_AGENT=UniCrawlerMapper/0.1

# Parser
PARSER_REPLICAS=1
PARSER_WORKERS=4
PARSER_REDIS_POOL_SIZE=8
PARSER_REQUEST_TIMEOUT=30s
PARSER_RENDER_TIMEOUT=60s
PARSER_MAX_PDF_BYTES=52428800
PARSER_MAX_RETRIES=2
PARSER_QUEUE_BLOCK_TIME=5s
PARSER_USER_AGENT=UniCrawlerParser/0.1

# Vectorizer
VECTORIZER_PROCESSING_QUEUE=vectorizer:processing
VECTORIZER_FAILED_QUEUE=vectorizer:failed
VECTORIZER_OVERSIZED_QUEUE=vectorizer:oversized
VECTORIZER_QUEUE_BLOCK_TIME=5
VECTORIZER_REDIS_SOCKET_TIMEOUT=15
VECTORIZER_COLLECTION_PREFIX=unicrawler
VECTORIZER_COLLECTION_SCOPE=domain
VECTORIZER_EMBEDDING_PROVIDER=fastembed
VECTORIZER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_API_KEY=
VECTORIZER_CHUNK_TOKENS=700
VECTORIZER_CHUNK_OVERLAP_TOKENS=100
VECTORIZER_MAX_DOCUMENT_CHARS=0
VECTORIZER_MAX_CHUNKS_PER_DOCUMENT=1000
VECTORIZER_SUMMARY_GROUP_CHUNKS=40
VECTORIZER_MAX_SUMMARY_CHUNKS=500
VECTORIZER_SUMMARY_TOKENS=450
VECTORIZER_BATCH_SIZE=32
VECTORIZER_MAX_RETRIES=3
VECTORIZER_RETRY_BACKOFF_SECONDS=2

# Monitor
MONITOR_PORT=8080
MONITOR_REPLAY_BATCH_SIZE=1000
MONITOR_ADMIN_USERNAME=admin
# Generate with: printf '%s' 'your-password' | sha256sum
MONITOR_ADMIN_PASSWORD_HASH=
MONITOR_SESSION_SECRET=change-me
MONITOR_SECURE_COOKIES=false
